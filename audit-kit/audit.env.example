# Copiar a un archivo privado fuera de git, editar valores y cargar antes de ejecutar.
# Ejemplo: set -a; . ./audit.env; set +a

# Obligatorio para análisis estático.
AUDIT_PROJECT=/ruta/absoluta/al/proyecto-django
AUDIT_PRODUCT_NAME="Nombre del Producto"

# Opcional. Necesario para checks nativos de Django.
AUDIT_DJANGO_SETTINGS_MODULE="config.settings"

# Prefijo de comando usado dentro de AUDIT_PROJECT para manage.py.
# Ejemplos seguros, sin operadores de shell:
#   AUDIT_DJANGO_COMMAND_PREFIX="poetry run python"
#   AUDIT_DJANGO_COMMAND_PREFIX=".venv/bin/python"
# Activar virtualenvs antes de ejecutar el runner.
AUDIT_DJANGO_COMMAND_PREFIX="poetry run python"

# Evidencia manual A01. Usar templates en audit-kit/templates/ como punto de partida.
AUDIT_AUTHZ_MATRIX=""
AUDIT_IDOR_REVIEW=""
AUDIT_SESSION_REVIEW=""

# Evidencia y configuración PR5 (DAST autenticado + API fuzzing).
# En el modelo actual, A05 espera esta evidencia como requerida; dejarla vacía puede bajar cobertura o hacer fallar gates altos/100%.
AUDIT_OPENAPI_SPEC=""
AUDIT_API_BASE_URL=""
# Dejar vacío por defecto para no activar accidentalmente el gating de PR5.
# Definir solo cuando se use flujo autenticado.
AUDIT_AUTH_HEADER_NAME=""
AUDIT_AUTH_HEADER_VALUE=""
AUDIT_API_FUZZING_REVIEW=""
# N > 0 exige autorización DAST y activa, pero no ejecuta fuzzing por sí solo.
AUDIT_SCHEMATHESIS_MAX_EXAMPLES=0

# URL de staging/producción autorizada para DAST pasivo.
AUDIT_TARGET_URL="https://staging.ejemplo.com"

# Debe ser true para ejecutar cualquier prueba DAST contra AUDIT_TARGET_URL.
# Para DAST autenticado, coordinar además credenciales, ventana de prueba y allow-list WAF.
AUDIT_DAST_AUTHORIZED=false
AUDIT_ACTIVE_DAST_AUTHORIZED=false

# Directorio de salida. Si se deja vacío se genera en audit-kit/runs/.
AUDIT_OUTPUT_DIR=""

# Toggle de escáneres.
AUDIT_RUN_DAST=true
AUDIT_RUN_ZAP=true
AUDIT_RUN_NUCLEI=true

# Umbral minimo de evidencia requerida para gates OWASP.
AUDIT_COVERAGE_THRESHOLD=80

# DefectDojo.
DD_URL="http://localhost:8080"
DD_API_TOKEN=""
DD_PRODUCT_NAME="$AUDIT_PRODUCT_NAME"
DD_ENGAGEMENT_NAME="OWASP Top 10:2025 - Audit"

# Abrir UI local al finalizar si la importación fue exitosa.
# Endpoints locales: http://localhost:8080 y https://localhost:8443.
AUDIT_OPEN_DEFECTDOJO=false
