{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:owasp:audit-kit:evidence-manifest:1.0",
  "title": "OWASP Django Evidence Manifest",
  "type": "object",
  "required": ["schema_version", "owasp_version", "generated_at", "product", "project", "run", "authorization", "artifacts", "coverage", "coverage_summary", "gates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "owasp_version": {"type": "string", "const": "OWASP Top 10:2025"},
    "generated_at": {"type": "string", "format": "date-time"},
    "product": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["path", "settings_module", "target_url"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "settings_module": {"type": "string"},
        "target_url": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": ["output_dir", "reports_dir", "timestamp", "runner"],
      "additionalProperties": false,
      "properties": {
        "output_dir": {"type": "string"},
        "reports_dir": {"type": "string"},
        "timestamp": {"type": "string"},
        "runner": {"type": "string"}
      }
    },
    "authorization": {
      "type": "object",
      "required": ["dast", "zap", "nuclei", "active_dast", "trufflehog", "defectdojo_import"],
      "additionalProperties": false,
      "properties": {
        "dast": {"type": "boolean"},
        "zap": {"type": "boolean"},
        "nuclei": {"type": "boolean"},
        "active_dast": {"type": "boolean"},
        "trufflehog": {"type": "boolean"},
        "defectdojo_import": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/artifact"}
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/category"}
    },
    "coverage_summary": {"$ref": "#/$defs/coverage_summary"},
    "gates": {"$ref": "#/$defs/gates"},
    "manual_signoff": {
      "type": "array",
      "items": {"$ref": "#/$defs/signoff"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "exists", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string"}
      }
    },
    "category": {
      "type": "object",
      "required": ["id", "name", "status", "coverage_percent", "required_present", "required_total", "missing_required", "failed_results", "automated", "manual", "required_manual_missing"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^A(0[1-9]|10)$"},
        "name": {"type": "string"},
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "coverage_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "required_present": {"type": "integer", "minimum": 0},
        "required_total": {"type": "integer", "minimum": 0},
        "missing_required": {"type": "array", "items": {"type": "string"}},
        "failed_results": {"type": "array", "items": {"type": "string"}},
        "automated": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "manual": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "required_manual_missing": {"type": "array", "items": {"type": "string"}}
      }
    },
    "coverage_summary": {
      "type": "object",
      "required": ["coverage_percent", "required_present", "required_total"],
      "additionalProperties": false,
      "properties": {
        "coverage_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "required_present": {"type": "integer", "minimum": 0},
        "required_total": {"type": "integer", "minimum": 0}
      }
    },
    "gates": {
      "type": "object",
      "required": ["status", "threshold", "coverage_percent", "failed_categories"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail"]},
        "threshold": {"type": "integer", "minimum": 0, "maximum": 100},
        "coverage_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "failed_categories": {"type": "array", "items": {"type": "string", "pattern": "^A(0[1-9]|10)$"}}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "required", "status", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "required": {"type": "boolean"},
        "status": {"type": "string", "enum": ["present", "missing", "optional_missing"]},
        "artifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "signoff": {
      "type": "object",
      "required": ["category", "control", "status"],
      "additionalProperties": false,
      "properties": {
        "category": {"type": "string", "pattern": "^A(0[1-9]|10)$"},
        "control": {"type": "string"},
        "status": {"type": "string", "enum": ["pending", "accepted", "rejected", "not_applicable"]},
        "owner": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}
